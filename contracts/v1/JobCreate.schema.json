{
  "$defs": {
    "Attachment": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "mime_type": {
          "default": "application/octet-stream",
          "maxLength": 120,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "data_base64": {
          "maxLength": 2800000,
          "title": "Data Base64",
          "type": "string"
        }
      },
      "required": [
        "name",
        "data_base64"
      ],
      "title": "Attachment",
      "type": "object"
    },
    "EngineCommand": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "enum": [
            "message.prepare",
            "message.execute",
            "campaign.start",
            "campaign.status",
            "campaign.pause",
            "campaign.resume",
            "campaign.stop",
            "campaign.assignment"
          ],
          "title": "Command",
          "type": "string"
        },
        "parameters": {
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "title": "EngineCommand",
      "type": "object"
    },
    "PreparedMessage": {
      "additionalProperties": false,
      "properties": {
        "to": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "To",
          "type": "array"
        },
        "subject": {
          "maxLength": 998,
          "title": "Subject",
          "type": "string"
        },
        "body": {
          "maxLength": 250000,
          "title": "Body",
          "type": "string"
        },
        "body_format": {
          "default": "text",
          "enum": [
            "text",
            "html"
          ],
          "title": "Body Format",
          "type": "string"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "maxItems": 4,
          "title": "Attachments",
          "type": "array"
        },
        "rfc822_message_id": {
          "anyOf": [
            {
              "maxLength": 254,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rfc822 Message Id"
        }
      },
      "required": [
        "to",
        "subject",
        "body"
      ],
      "title": "PreparedMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1,
      "default": 1,
      "enum": [
        1
      ],
      "title": "Protocol Version",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 120,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "worker_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Worker Id",
      "type": "string"
    },
    "operation": {
      "enum": [
        "runtime.probe",
        "gmail.compose",
        "gmail.draft",
        "engine.command"
      ],
      "title": "Operation",
      "type": "string"
    },
    "account_email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Email"
    },
    "execution": {
      "default": "preview",
      "enum": [
        "preview",
        "send"
      ],
      "title": "Execution",
      "type": "string"
    },
    "confirmation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmation"
    },
    "message": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreparedMessage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineCommand"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "idempotency_key",
    "worker_id",
    "operation"
  ],
  "title": "JobCreate",
  "type": "object"
}
